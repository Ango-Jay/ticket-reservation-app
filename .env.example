POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ticket
POSTGRES_PASSWORD=ticket
POSTGRES_DB=ticket_reservation

DATABASE_URL=postgresql://ticket:ticket@localhost:5432/ticket_reservation

PORT=3000
NODE_ENV=development
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=info

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/admins/sso/google/callback
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_GRACE_MS=30000
# Used only when the admins table is empty (first Google login)
ADMIN_BOOTSTRAP_EMAIL=
